# SICR3P SpA — operadora (público / legal)
SICR3P_RAZON_SOCIAL=SICR3P SpA
SICR3P_NOMBRE_FANTASIA=sicr3p spa
SICR3P_RUT=78.529.455-6
# Casilla pública. En Ferozo ya existe edward@sicr3p.cl — creá contacto@ o
# apuntá este valor a edward@ hasta tener la casilla. MX: docs/dns-vps-correo.md
SICR3P_CONTACT_EMAIL=contacto@sicr3p.cl
SICR3P_CONTACT_PHONE=+56 9 0000 0000
SICR3P_ADDRESS=Antofagasta, Región de Antofagasta, Chile

# Fundación Entretodos — dueña
SICR3P_FUNDACION_RAZON=Fundación Entretodos
SICR3P_FUNDACION_RUT=65.279.032-1
SICR3P_FUNDACION_ADDRESS=Los Conquistadores 13704, Antofagasta

# Redes solo si son URLs reales (vacío = no se muestran)
SICR3P_LINKEDIN=
SICR3P_INSTAGRAM=

# dLocal Go — payouts / pay-in
# simulator (demo local) | sandbox|prueba|test (API sandbox) | live|produccion
# Recomendado: sandbox con DLOCAL_SANDBOX_* antes de live.
DLOCAL_MODE=sandbox
# Legacy (se usan si no hay slot del modo activo):
# DLOCAL_API_KEY=
# DLOCAL_SECRET_KEY=
# DLOCAL_BASE_URL=
# DLOCAL_WEBHOOK_SECRET=

# --- Entorno PRUEBA (sandbox) ---
DLOCAL_SANDBOX_API_KEY=
DLOCAL_SANDBOX_SECRET_KEY=
# DLOCAL_SANDBOX_WEBHOOK_SECRET=

# --- Entorno PRODUCCIÓN (live) — solo tras validar sandbox ---
DLOCAL_LIVE_API_KEY=
DLOCAL_LIVE_SECRET_KEY=
# DLOCAL_LIVE_WEBHOOK_SECRET=

# dLocal for Platforms — onboarding de vendedores / submerchants
DLOCAL_PLATFORMS_MODE=sandbox
# Legacy:
# DLOCAL_PLATFORMS_LOGIN=
# DLOCAL_PLATFORMS_TRANS_KEY=
# DLOCAL_PLATFORMS_SECRET=
# DLOCAL_PLATFORMS_BASE_URL=
DLOCAL_PLATFORMS_NOTIFICATION_URL=https://sicr3p.cl/api/baas/webhooks/dlocal-platforms

DLOCAL_PLATFORMS_SANDBOX_LOGIN=
DLOCAL_PLATFORMS_SANDBOX_TRANS_KEY=
DLOCAL_PLATFORMS_SANDBOX_SECRET=

DLOCAL_PLATFORMS_LIVE_LOGIN=
DLOCAL_PLATFORMS_LIVE_TRANS_KEY=
DLOCAL_PLATFORMS_LIVE_SECRET=

# HubSpot Private App (opcional; sin token = simulador local)
HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_ACCESS_TOKEN=

# Auth demo / sesión
# AUTH_SECRET=
SESSION_SECRET=
PORT=3000
HOSTNAME=0.0.0.0

# Supabase self-hosted (DonWeb). La anon key es pública; no pongas aquí la service_role.
# La URL de Postgres 127.0.0.1:5432 solo funciona dentro del VPS, no desde esta app.
# Cuando el panel enlace el dominio, usá https://sicr3p.cl (A → 149.50.155.61).
NEXT_PUBLIC_SUPABASE_URL=https://sicr3p.cl
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deploy VPS DonWeb. El firewall del panel tiene que abrir 80, 443 y 5757.
# sicr3p.cl ya debe resolver a 149.50.155.61 antes de Configurar Dominio y SSL.
# Postgres no se publica: sigue en 127.0.0.1:5432.
# VPS_HOST=149.50.155.61
# VPS_USER=root
# VPS_PORT=5757
# APP_DIR=/var/www/sicr3p

