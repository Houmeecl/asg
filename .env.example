# Firma de sesiones (obligatorio en producción)
SESSION_SECRET=

# Integración con Nico Seguros (https://api.nicoseguros.com/api-docs/index.html)
# Credenciales del usuario corredor/admin en Nico. Solo se usan en el servidor.
NICO_API_EMAIL=
NICO_API_PASSWORD=
# Opcional. Por defecto https://api.nicoseguros.com
# NICO_API_URL=

# Piloto de cobertura por índice
# Referencia de la OPINIÓN LEGAL ESCRITA que respalda operar contratos reales. Sin ella, todo contrato es SIMULADO.
OPINION_LEGAL_REF=
# Reserva de capital declarada (CLP). La suma de montos máximos de contratos REAL no puede superarla.
RESERVA_CLP=
# Datos de tu empresa para el borrador de contrato
EMPRESA_NOMBRE=
EMPRESA_RUT=
# Mostrar las pestañas de Nico Seguros en el admin (1 = sí). Por defecto están ocultas.
NICO_HABILITADO=
